# 访问令牌：留空时接口只允许本机（127.0.0.1）访问；
# 部署到内网/服务器前必须设置，前端需要在 frontend/.env.local 配同一个值。
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_AUTH_TOKEN=

OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe-diarize
OPENAI_EXTRACTION_MODEL=gpt-5.6-terra
OPENAI_AUDIO_CHUNK_SECONDS=300

# 转写前的音频规范化：统一转成 16kHz 单声道 FLAC 并做响度归一（loudnorm）。
# 口袋录音往往电平很低，这一步对识别率的提升最直接。
# 设为 false 会退回"原文件直接上传"的旧行为。
OPENAI_AUDIO_NORMALIZE=true
# ffmpeg 滤镜链。默认 highpass 去手机摩擦低频 + EBU R128 响度归一。
# 想去掉降噪/归一可以留空。
OPENAI_AUDIO_FILTERS=highpass=f=80,loudnorm=I=-16:TP=-1.5:LRA=11

OPENAI_PROXY_URL=
OPENAI_REQUEST_TIMEOUT_SECONDS=600
OPENAI_MAX_RETRIES=4
ANALYSIS_CONFIDENCE_THRESHOLD=0.75

# 转写提示词与幻觉词表在 backend/prompts/ 下，改文件即可生效、无需重启：
#   transcription_prompt.md      品牌/产品/行业术语热词表
#   hallucination_phrases.txt    模型在静音段凭空生成的字符片段
