# macOS
.DS_Store

# Python
backend/.venv/
backend/**/__pycache__/
backend/**/*.py[cod]
backend/.pytest_cache/

# SQLite database
backend/data/*.db
backend/data/*.db-*

# Uploaded source files
backend/storage/imports/*
backend/storage/recordings/*
backend/storage/transcripts/*

# Keep empty storage directories in Git
!backend/storage/imports/.gitkeep
!backend/storage/recordings/.gitkeep
!backend/storage/transcripts/.gitkeep

# Environment variables and secrets
.env
.env.*
!.env.example

# Frontend dependencies and generated files
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/coverage/
frontend/*.tsbuildinfo
frontend/.vercel/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
